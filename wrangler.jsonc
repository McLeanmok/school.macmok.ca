{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-macmok-ca",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
  },
}

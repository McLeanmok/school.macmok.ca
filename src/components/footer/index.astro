---
// importing components, loop and CSS
import Container from "../container.astro";
import navData from "../../data/menu.json";
import "./styles.css"
interface Props {
    agencyName?: string,
    noBottomBar?: boolean
    hasCards?: boolean
    mainContent?: boolean
    bottomBarText?: string
}

const { noBottomBar, bottomBarText = "No Generative AI was used in the production of this website", hasCards, mainContent = true, agencyName = "Your Agency Name"} = Astro.props;
---

<footer class="site-footer" id="footer">
    <h2 class="sr-only">Footer</h2>
    <Container customClass="site-footer__inner">
        <!-- card gallery -->
        {hasCards &&
            <ul class="site-footer__feature-cards">
            
                    {/* BEGIN CARD */}
                    <li>
                        <article class="site-footer__feature-card">
                            <h3 class="site-footer__feature-card-title">Feature 1</h3>
                            <p class="site-footer__feature-card-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec vel sapien augue. Donec vel sapien augue.</p>
                        </article>
                </li> {/* end card */}
                    {/* BEGIN CARD */}
                    <li> 
                        <article class="site-footer__feature-card">
                            <h3 class="site-footer__feature-card-title">Feature 2</h3>
                            <p class="site-footer__feature-card-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec vel sapien augue. Donec vel sapien augue.</p>
                        </article>
                </li> {/* end card */}
                    {/* BEGIN CARD */}
                    <li>
                        <article class="site-footer__feature-card">
                            <h3 class="site-footer__feature-card-title">Feature 3</h3>
                            <p class="site-footer__feature-card-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec vel sapien augue. Donec vel sapien augue.</p>
                        </article>
                </li> {/* end card */}
                    </ul>
        }
        {/* main content */}
        {mainContent &&
                <Container customClass="site-footer__body">
                    {/* Site info */}
                    <div class="site-footer__content-group">
                             {/* Logo - this is just a placeholder. Go right ahead and replace it with your company logo.  */}
                    <a href="/" class="site-wordmark">Mac Mylymok School Portfolio</a><!-- -- End brand -->

        <p class="site-footer__legal">Copyright &copy; <span id="year"></span>| {agencyName}: All Rights reserved
        </p>
    </div>    
                    <div class="site-footer__content-group">
                        <h2 class="site-footer__content-group-heading">Quick Links</h2>
                        <nav class="site-footer__nav">
                            <ul class="site-footer__nav-list">
                                {
                                    navData.map((item) => (
                                        <li><a href={item.url}>{item.text}</a></li>
                                    ))
                                }
                            </ul>
                        </nav>
                    </div>    
                    <div class="site-footer__content-group">
                           <slot name="right">
                             <article class="site-footer__card">
                                <h2 class="site-footer__card-title">Mission Statement</h2>
                                <p class="site-footer__card-description">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptate nostrum odit hic, doloribus qui voluptatem. Unde iste illum exercitationem saepe sint eos pariatur quibusdam? Nisi alias incidunt fuga amet deserunt?</p>
                            </article>
                           </slot>
                        </div>    
                </Container>}
         
            
    </Container>
    <!-- bottom bar -->
    {!noBottomBar && 
        <div class="site-footer__bottom-bar">
            <Container customClass="site-footer__bottom-bar-inner">
                <p class="site-footer-bottom-message">{bottomBarText}</p>
            </Container>
        </div>
        }
    </footer>

<!-- Loading JS -->
 <script>

    // automatically update the year in the copyright notice
    const yearSpan = document.getElementById('year');
    const currentYear = new Date().getFullYear();
    if (yearSpan) {
        yearSpan.textContent = currentYear.toString();
    }
    // Set aria-current="page" on the current page's link in the footer navigation
const navLinks = document.querySelectorAll('.site-footer__nav li a');

// Get the current page URL and hash
const currentPageUrl = window.location.pathname;
const currentPageHash = window.location.hash.substring(1); // Remove the '#' character

navLinks.forEach(link => {
  const linkUrl = link.getAttribute('href');
  const linkHash = linkUrl && linkUrl.includes('#') ? linkUrl.split('#')[1] : null;
  
  // Extract just the pathname from the link for comparison
  const linkPathname = linkUrl && linkUrl.startsWith('/') ? linkUrl.split('#')[0] : null;
  
  if (linkPathname === currentPageUrl || (linkHash && linkHash === currentPageHash)) {
    link.setAttribute('aria-current', 'page');
  } else {
    link.removeAttribute('aria-current');
  }
});
 </script>
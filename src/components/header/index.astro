---
import "./style.css"; // component stylesheet
import menu from "../../data/menu.json" // JSON menu data. If you are using this as a plug-in, you will need to rip the file from the GitHub repo and place it in your projects data folder. Either way, you will need to customize it to include your navigation links
import Container from "../container.astro";

interface Props {
    hasCta?: boolean;
}
const { hasCta } = Astro.props;
---

<header class="site-header">
    <Container  customClass="site-header__inner">
        <!-- Logo - this is just a placeholder. Go right ahead and replace it with your company logo. -->
            <a href="/" class="site-wordmark">Mac Mylymok School Portfolio</a><!-- -- End brand -->
        <input type="checkbox" class="site-header__nav-toggle" id="nav-toggle"  />
                               <label for="nav-toggle" class="site-header__nav-toggle-label" aria-label="toggle the mobile menu" id="openModalButton">
                               <span></span>
                               <span></span>
                               <span></span>
                              </label>
        <!-- Navigation  (Powered by JSON)-->
        <nav class="site-header__nav">
            <ul class="site-header__nav-links" {...(hasCta && { 'data-nav-layout': 'cta' })}>
                {
                    menu.map((link) => (
                        <li class="site-header__nav-item">
                            <a href={link.url} title={link.title} class="site-header__nav-link">{link.text}</a>
                        </li>
                    ))
                }
            </ul>
         </nav>
    </Container>
</header>

<script>
const navLinks = document.querySelectorAll('.site-header__nav li a');

// Get the current page URL and hash
const currentPageUrl = window.location.pathname;
const currentPageHash = window.location.hash.substring(1); // Remove the '#' character

navLinks.forEach(link => {
  const linkUrl = link.getAttribute('href');
  const linkHash = linkUrl && linkUrl.includes('#') ? linkUrl.split('#')[1] : null;
  
  // Extract just the pathname from the link for comparison
  const linkPathname = linkUrl && linkUrl.startsWith('/') ? linkUrl.split('#')[0] : null;
  
  if (linkPathname === currentPageUrl || (linkHash && linkHash === currentPageHash)) {
    link.setAttribute('aria-current', 'page');
  } else {
    link.removeAttribute('aria-current');
  }
});
        
</script>